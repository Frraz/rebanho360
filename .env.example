# =============================================================================
# Rebanho360 — modelo de variáveis de ambiente
#
# Copie para .env e preencha. O .env NUNCA é versionado (ver .gitignore).
#   Desenvolvimento: ./deploy/local.sh cria o .env a partir deste arquivo e gera
#                    a DJANGO_SECRET_KEY sozinho. Os valores abaixo já funcionam.
#   Produção:        cp .env.example .env && chmod 600 .env, e siga o checklist.
#
# Regras do formato (o docker compose e os scripts de deploy leem este arquivo
# linha a linha): NOME=valor, sem aspas, sem espaço em volta do "=", um valor por
# linha. Comentário só em linha própria — nunca no fim de uma linha de valor.
#
# CHECKLIST DE PRODUÇÃO — o que muda em relação ao desenvolvimento
#   [ ] DJANGO_SETTINGS_MODULE  (o docker-compose.prod.yml já força config.settings.prod)
#   [ ] DJANGO_SECRET_KEY       gerada, longa e única
#   [ ] DJANGO_DEBUG=False
#   [ ] DJANGO_ALLOWED_HOSTS    só o domínio real (sem "*", sem localhost)
#   [ ] POSTGRES_PASSWORD       forte, e a MESMA senha dentro de DATABASE_URL
#   [ ] EMAIL_*                 SMTP real (o e-mail é obrigatório para todo usuário)
#   [ ] DEFAULT_FROM_EMAIL      endereço que o SMTP aceita
#   [ ] DJANGO_HSTS_SECONDS     0 até o HTTPS estar confirmado; depois, aumentar
#   [ ] STATIC_HOST_DIR         pasta que o nginx serve em /static/
#   [ ] RCLONE_REMOTE           destino externo do backup (sem ele NÃO é backup de verdade)
# =============================================================================


# --- Django ------------------------------------------------------------------
# dev:  config.settings.dev   |   produção: config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Chave secreta da aplicação. Em desenvolvimento pode ficar vazia (o deploy/local.sh
# gera uma). Em produção a aplicação RECUSA subir sem ela. Para gerar:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Trocar a chave invalida as sessões abertas e os links de senha já enviados.
DJANGO_SECRET_KEY=

# Produção: False (com True a aplicação recusa subir).
DJANGO_DEBUG=True

# Hosts aceitos, separados por vírgula. Produção: só o domínio real, ex.:
#   DJANGO_ALLOWED_HOSTS=sistema.suafazenda.com.br
# Em produção "*" e lista vazia são recusados. O 1º host também é usado pelo
# deploy/healthcheck.sh (a menos que HEALTHCHECK_HOST esteja definido).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# --- Banco (PostgreSQL 16 — nunca SQLite) -------------------------------------
# As variáveis POSTGRES_* criam o banco no contêiner; DATABASE_URL é o que o
# Django usa. Os dois precisam concordar (usuário, senha e nome).
# Em produção troque a senha nos DOIS lugares. Se a senha tiver caracteres
# especiais (@ : / # ? %), codifique-os na URL (ex.: @ vira %40) — ou, mais
# simples, use só letras e números.
POSTGRES_DB=rebanho360
POSTGRES_USER=rebanho360
POSTGRES_PASSWORD=rebanho360
DATABASE_URL=postgres://rebanho360:rebanho360@db:5432/rebanho360
# O Postgres e o Redis NÃO são expostos ao host (regra de segurança do projeto).


# --- Redis (cache + fila do Celery) -------------------------------------------
REDIS_URL=redis://redis:6379/0


# --- E-mail -------------------------------------------------------------------
# Usado em convites, redefinição de senha e avisos de pedido de acesso. Como o
# e-mail é obrigatório para todo usuário, sem SMTP ninguém recebe o link para
# definir a senha. Em desenvolvimento os e-mails saem no console do contêiner
# `web` e estas variáveis podem ficar vazias. A porta 587 usa STARTTLS.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remetente dos e-mails (precisa ser um endereço que o SMTP aceite).
DEFAULT_FROM_EMAIL=Rebanho360 <nao-responda@seudominio.com.br>
# Além dos administradores e gestores cadastrados, quem mais recebe o aviso de
# pedido de acesso (endereços separados por vírgula; não cria usuário).
ACCESS_REQUEST_NOTIFY_EMAILS=


# --- Segurança ----------------------------------------------------------------
# HSTS: deixe 0 até confirmar que o HTTPS funciona (ligado antes da hora, o
# navegador se recusa a abrir o site sem HTTPS). Depois: 31536000 (1 ano).
DJANGO_HSTS_SECONDS=0

# Segundo fator (código no celular). False = opcional e recomendado a todos;
# True = obrigatório para TODOS os usuários (quem ainda não ativou é levado à
# configuração no próximo acesso). Decisão de Warley (2026-10-03): fica False;
# só mude se a regra da operação mudar.
TWO_FACTOR_OBRIGATORIO=False

# Console de auditoria: além do ADMIN, o GESTOR também pode ver a trilha?
AUDIT_CONSOLE_INCLUDE_GESTOR=False


# --- Exportação de dados --------------------------------------------------------
# Dias em que o arquivo exportado fica no servidor antes de ser apagado.
EXPORT_RETENTION_DAYS=30
# Quantas exportações um mesmo usuário pode ter ao mesmo tempo (na fila ou rodando).
EXPORT_MAX_ACTIVE_PER_USER=2


# --- Observabilidade (opcional) -------------------------------------------------
# DSN do Sentry. Vazio = desligado. Só é lido em produção; dados pessoais não
# são enviados (send_default_pii=False).
SENTRY_DSN=


# --- Desempenho -----------------------------------------------------------------
# Cache de resultados do dashboard e do Início (invalidado por escrita, nunca por
# tempo; docs/operacao/02-desempenho.md §6). 0 desliga e tudo é calculado a cada abertura.
# CACHE_DE_RESULTADOS=1
# Só em desenvolvimento: liga o painel de SQL do debug toolbar (deixa as telas mais lentas).
# DJANGO_DEBUG_TOOLBAR=1


# --- Deploy (scripts em deploy/; só em produção, todos opcionais) ----------------
# Porta local (só 127.0.0.1) em que o nginx do host encontra o sistema. Padrão 8010;
# mude se estiver ocupada (`ss -ltnp`) e use a mesma no proxy_pass do vhost.
# WEB_HOST_PORT=8010

# Gunicorn (gunicorn.conf.py). Padrão: 9 workers × 2 threads, dimensionado para o
# limite de 2,3 GB do `web`. Cada worker usa ~150–250 MB; no VPS compartilhado,
# se `free -h` mostrar pouca folga, baixe os workers aqui (ex.: 5) e recrie o web:
#   dc up -d --force-recreate web
# WEB_CONCURRENCY=9
# GUNICORN_THREADS=2

# Pasta do host que o nginx serve em /static/ — o deploy.sh copia o collectstatic
# para lá. Sem ela o deploy avisa e o nginx precisa servir os estáticos de outro jeito.
# STATIC_HOST_DIR=/var/www/rebanho360/static

# Domínio que o deploy/healthcheck.sh envia no cabeçalho Host (padrão: o 1º de
# DJANGO_ALLOWED_HOSTS).
# HEALTHCHECK_HOST=

# Destino externo do backup, no formato do rclone (ex.: meudrive:rebanho360).
# Sem isto o backup fica só no VPS — e isso NÃO é backup de verdade.
# RCLONE_REMOTE=

# Outros ajustes dos scripts (BACKUP_ROOT, HEALTHCHECK_URL, HEALTHCHECK_RETRIES,
# HEALTHCHECK_INTERVAL) são lidos do ambiente do shell, não deste arquivo:
#   BACKUP_ROOT=/mnt/backups ./deploy/backup.sh
# Senha do superusuário oculto de suporte, só para `criar_superusuario_oculto --noinput`:
# defina no ambiente do comando, não aqui.
