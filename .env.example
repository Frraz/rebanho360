# Copie para .env e preencha. .env nunca é versionado (ver .gitignore).
# Permissão recomendada em produção: chmod 600 .env

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Banco (Postgres 16 — nunca SQLite) ---
DATABASE_URL=postgres://rebanho360:rebanho360@db:5432/rebanho360
POSTGRES_DB=rebanho360
POSTGRES_USER=rebanho360
POSTGRES_PASSWORD=

# --- Redis (cache + broker Celery) ---
REDIS_URL=redis://redis:6379/0

# --- E-mail (produção) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remetente dos e-mails do sistema (precisa ser um endereço que o SMTP aceite).
DEFAULT_FROM_EMAIL=Rebanho360 <nao-responda@seudominio.com.br>
# Além dos administradores cadastrados, quem mais recebe o aviso de pedido de acesso (vírgula).
ACCESS_REQUEST_NOTIFY_EMAILS=

# --- Observabilidade (opcional) ---
SENTRY_DSN=

# --- HSTS: só depois de confirmar que o HTTPS funciona ---
DJANGO_HSTS_SECONDS=0

# --- Console de auditoria ---
AUDIT_CONSOLE_INCLUDE_GESTOR=False

# --- Deploy (scripts em deploy/; só em produção, todos opcionais) ---
# Pasta do host que o nginx serve em /static/ — o deploy.sh copia o collectstatic para lá.
# STATIC_HOST_DIR=/var/www/rebanho360/static
# Domínio usado pelo deploy/healthcheck.sh (padrão: o 1º de DJANGO_ALLOWED_HOSTS).
# HEALTHCHECK_HOST=
# Destino externo do backup (rclone). Sem isto, o backup fica só no VPS.
# RCLONE_REMOTE=
